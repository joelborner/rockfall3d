<rockfall3d/>

<terrain dem="N:\ramms\0_ROCKFALL\30_scree\chantsura\chant_sura\dem_20m.tif"/>

<rocks
    list="data/rocks.txt"
    density="2500"
    random_orientations="100"/>

<starts list="data/start_points.txt"/>

<simulation
    mu="0.5"
    dt="0.002"
    output_dir="output/lowres"
    orientation_seed="12345"
    roughness_seed="67890"/>


<stop
    max_time="200.0"
    max_steps="1000000"
    settle_min_steps="100"
    settle_linear_speed="0.1"
    settle_angular_speed="0.1"/>

<solver
    type="jor-prox"
    alpha="0.5"
    atol="1e-8"
    rtol="1e-6"
    maxiter="10000"/>

