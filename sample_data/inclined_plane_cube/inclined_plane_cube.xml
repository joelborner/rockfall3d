<rockfall3d/>

<terrain dem="inclined_plane.tif">
  <interaction type="coulomb_friction" mu="0.8"/>
</terrain>

<rocks
    list="rocks.txt"
    density="2500"
    random_orientations="1"/>

<starts list="release_points.txt"/>

<simulation
    en="0"
    et="0"
    dt="0.0005"
    dump_step="0.0025"
    output_dir="output"
    parallel_threads="1"
    orientation_seed="12345"/>

<output>
  <trajectory
      format="binary"
      metric="time,x,y,z,qw,qx,qy,qz,vx,vy,vz,vtot,wx,wy,wz,wtot,jumpH"/>
</output>

<stop
    max_time="5"
    max_steps="20000"
    settle_min_steps="100"
    settle_linear_speed="0.001"
    settle_angular_speed="0.001"/>

<integrator type="schweizer"/>

<solver
    type="sor-prox"
    alpha="1"
    atol="1e-08"
    rtol="1e-06"
    maxiter="10000"/>
